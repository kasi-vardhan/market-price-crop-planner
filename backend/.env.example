# Environment Configuration for Backend
# Copy this file to .env and configure with your keys

# LLM Providers (Groq recommended for speed and low cost)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Open Government Data (data.gov.in) Mandi Price API
DATA_GOV_API_KEY=your_data_gov_api_key_here
DATA_GOV_RESOURCE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# HuggingFace Token (optional, prevents rate limits on embedding downloads)
# HF_TOKEN=your_huggingface_token_here

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
